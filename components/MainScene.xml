<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene" backgroundUri="" backgroundColor="0x000000FF">
  <script type="text/brightscript" uri="pkg:/source/emberApi.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

  <interface>
    <function name="handleDeepLink" />
    <function name="handleInstantResume" />
    <function name="handleLowMemory" />
  </interface>

  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />

    <ActivationScene id="activationScene" visible="false" />
    <LoginScene      id="loginScene"      visible="false" />
    <RentalsScene    id="rentalsScene"    visible="false" />
    <PlayerScene     id="playerScene"     visible="false" />

    <ApiTask id="signOutTask" />

    <!-- Shown only in staging builds (tools/make-staging-zip.sh), never over the player. -->
    <Group id="stagingBadge" visible="false" translation="[1640, 36]">
      <Rectangle width="220" height="52" color="0xFFD60AFF" />
      <Label width="220" height="52" horizAlign="center" vertAlign="center"
             text="STAGING" color="0x000000FF">
        <Font role="font" uri="font:BoldSystemFontFile" size="30" />
      </Label>
    </Group>
  </children>
</component>
