<?xml version="1.0" encoding="utf-8"?>
<component name="RentalsScene" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/RentalsScene.brs" />
 
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x121212FF" />

    <Poster 
      id="headerLogo"
      translation="[80, 30]"
      width="360"
      height="200"
      loadDisplayMode="scaleToFit"
      uri="pkg:/images/logo/logo_header.png" />

    <!-- Full-width labels so the title and subtitle are centered on the screen. -->
    <Group translation="[0, 60]">
      <Label
        id="titleLabel"
        text="My Rentals"
        color="0xFFFFFFFF"
        width="1920"
        height="70"
        horizAlign="center"
        translation="[0,0]">
        <Font role="font" uri="font:BoldSystemFontFile" size="54" />
      </Label>
      
      <Label
        id="subtitleLabel"
        text="Your rentals, ready to watch."
        color="0xAAAAAAFF"
        width="1920"
        height="36"
        horizAlign="center"
        translation="[0, 76]">
        <Font role="font" uri="font:SystemFontFile" size="24" />
      </Label>
    </Group>

    <Group translation="[1450, 60]">
      <Group id="refreshBtn" focusable="true">
         <Rectangle id="refreshFill" width="180" height="60" color="0x2A2A2AFF" />
         <Label 
            id="refreshLabel"
            text="Refresh" 
            width="180" height="60" 
            horizAlign="center" vertAlign="center" 
            font="font:MediumBoldSystemFont" 
            color="0xFFFFFFFF" />
      </Group>

      <Group id="logoutBtn" translation="[220, 0]" focusable="true">
         <Rectangle id="logoutFill" width="180" height="60" color="0x2A2A2AFF" />
         <Label 
            id="logoutLabel"
            text="Sign Out" 
            width="180" height="60" 
            horizAlign="center" vertAlign="center" 
            font="font:MediumBoldSystemFont" 
            color="0xFFFFFFFF" />
      </Group>
    </Group>

    <Group id="focusedMetadata" translation="[80, 250]">
        <Label
            id="focusedTitle"
            text=""
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            width="1000"
            height="50"
            wrap="false" />
    </Group>

    <MarkupGrid
      id="grid"
      translation="[80, 330]"
      itemSize="[270, 480]"
      itemSpacing="[40, 60]"
      numColumns="6"
      numRows="2"
      vertFocusAnimationStyle="fixedFocusWrap"
      drawFocusFeedback="false"
      itemComponentName="RentalGridItem" />

    <!-- Loading, empty and error messages, shown in place of the grid. -->
    <Group id="messageGroup" translation="[0, 480]" visible="false">
      <Label id="messageTitle" width="1920" height="60" horizAlign="center"
             text="" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="40" />
      </Label>
      <Label id="messageDetail" translation="[360, 70]" width="1200" height="100"
             horizAlign="center" wrap="true" numLines="2" text="" color="0xAAAAAAFF">
        <Font role="font" uri="font:SystemFontFile" size="30" />
      </Label>
    </Group>

    <ApiTask id="rentalsTask" />
  </children>

  <interface>
    <!-- Input: set true to (re)load the library. -->
    <field id="reload" type="boolean" alwaysNotify="true" />
    <!-- Outputs -->
    <field id="library" type="node" alwaysNotify="true" />
    <field id="selectedRental" type="node" alwaysNotify="true" />
    <field id="logoutRequested" type="boolean" alwaysNotify="true" />
    <field id="signedOut" type="boolean" alwaysNotify="true" />
    <function name="releaseCachedContent" />
  </interface>
</component>