<?xml version="1.0" encoding="utf-8"?>
<component name="RentalGridItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/RentalGridItem.brs" />

  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <!-- Set by the MarkupGrid: false while focus is on Refresh / Sign Out. -->
    <field id="gridHasFocus" type="boolean" onChange="onFocusChanged" />
  </interface>

  <children>
    
    <Group id="scaleGroup" scaleRotateCenter="[135, 202]">
        
        <!-- Fills the frame (cropping a little if the art isn't 2:3), so no
             background shows around it. -->
        <Poster
          id="poster"
          width="270"
          height="405"
          loadWidth="270"
          loadHeight="405"
          translation="[0, 0]"
          loadDisplayMode="scaleToZoom" />

        <!-- Ember TV orange outline around the selected poster: four bars
             with a 2 px gap, drawn over the art's edges. -->
        <Group id="focusRing" visible="false">
          <Rectangle translation="[-8, -8]" width="286" height="6" color="0xEF6418FF" />
          <Rectangle translation="[-8, 407]" width="286" height="6" color="0xEF6418FF" />
          <Rectangle translation="[-8, -8]" width="6" height="421" color="0xEF6418FF" />
          <Rectangle translation="[272, -8]" width="6" height="421" color="0xEF6418FF" />
        </Group>

    </Group>

    <Label
      id="expirationLabel"
      translation="[0, 420]"
      width="270"
      height="40"
      color="0xAAAAAAFF"
      horizAlign="center"
      vertAlign="top"
      wrap="false">
      <Font role="font" uri="font:SystemFontFile" size="24" />
    </Label>

    <Animation id="focusAnim" duration="0.15" easeFunction="outQuad">
        <Vector2DFieldInterpolator id="scaleInterp" 
            key="[0.0, 1.0]" 
            keyValue="[[1.0, 1.0], [1.06, 1.06]]" 
            fieldToInterp="scaleGroup.scale" />
    </Animation>

  </children>
</component>